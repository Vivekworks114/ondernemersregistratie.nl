---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { postRouteSlugs, type BlogEntry } from '../../lib/blogPosts';

export async function getStaticPaths() {
  const blogEntries = (await getCollection('blog')).filter((entry) => !entry.data.draft);

  return blogEntries.flatMap((entry) =>
    postRouteSlugs(entry).map((slug) => ({
      params: { slug },
      props: { entry },
    })),
  );
}

interface Props {
  entry: BlogEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BlogPostLayout entry={entry}>
  <Content />
</BlogPostLayout>
