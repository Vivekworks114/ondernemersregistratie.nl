---
import { footerLinks } from '../data/footerLinks';

const socialLinks = [
  { label: 'Facebook', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'Twitter', href: '#' },
  { label: 'Youtube', href: '#' },
];
---

<footer class="footer">
  <div class="footer__top container">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <img
          src="/images/brand/logo.svg"
          alt="Ondernemersregistratie.nl"
          width="310"
          height="27"
          loading="lazy"
        />
      </a>

      <div class="footer__social">
        <a href="#" class="footer__social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
          </svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Twitter" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <a href="#" class="footer__social-link" aria-label="Youtube" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>

      <p class="footer__tagline">
        Op ondernemersregistratie.nl vind je bedrijfsinformatie zoals het hoort: betrouwbaar, openbaar
        en overzichtelijk. Voeg jouw onderneming toe of vind anderen in jouw branche.
      </p>
    </div>

    <div class="footer__links">
      <div class="footer__column">
        <p class="footer__column-title">Over ons</p>
        <ul>
          {footerLinks.main.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__column">
        <p class="footer__column-title">Zoekopties</p>
        <ul>
          {footerLinks.zoekopties.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__column">
        <p class="footer__column-title">Bedrijven</p>
        <ul>
          {footerLinks.bedrijven.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__column">
        <p class="footer__column-title">Contact</p>
        <ul>
          {footerLinks.contact.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom container">
    <a href="/sitemap/">Sitemap</a>
    <p>© 2025 Alle rechten voorbehouden</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-primary);
    padding-top: var(--space-3xl);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer__logo img {
    height: 1.75rem;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    transition:
      background var(--transition-base),
      color var(--transition-base),
      transform var(--transition-fast);
  }

  .footer__social-link:hover {
    background: var(--color-accent);
    color: var(--color-text);
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer__tagline {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    line-height: 1.65;
    opacity: 0.85;
    max-width: 22rem;
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl) var(--space-lg);
  }

  .footer__column-title {
    font-family: var(--font-nav);
    font-weight: 700;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .footer__column ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__column a {
    font-size: var(--text-xs);
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
    transition:
      opacity var(--transition-fast),
      color var(--transition-fast);
  }

  .footer__column a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-lg);
    font-size: var(--text-xs);
    opacity: 0.6;
  }

  .footer__bottom a:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }

    .footer__links {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
