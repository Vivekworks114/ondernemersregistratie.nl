---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import { resolveCardImageOrPlaceholder } from '../lib/blogImages';
import { formatBlogDate, postSlug, sortBlogPosts } from '../lib/blogPosts';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const posts = sortBlogPosts(await getCollection('blog'));
const displayPosts = limit ? posts.slice(0, limit) : posts;
---

<section class="blog-listing section">
  <div class="container">
    <div class="blog-listing__grid">
      {
        displayPosts.map((post) => {
          const slug = postSlug(post);
          return (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.description}
              date={formatBlogDate(post.data.pubDate)}
              dateISO={post.data.pubDate.toISOString()}
              slug={slug}
              featuredImage={resolveCardImageOrPlaceholder(
                post.data,
                post.body,
                slug,
                post.data.title,
              )}
              variant="full"
            />
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .blog-listing {
    background: var(--color-primary);
    padding-block: var(--space-section);
  }

  .blog-listing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .blog-listing__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-listing__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.1875rem;
    }
  }
</style>
