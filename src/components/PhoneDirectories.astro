---
import { phoneDirectories } from '../data/phoneDirectories';
---

<section class="directories section">
  <div class="container">
    <div class="directories__grid">
      {
        phoneDirectories.map((directory) => (
          <div class="directories__column">
            <div class="directories__title-wrap">
              <h3 class="directories__title">{directory.title}</h3>
            </div>
            <ul class="directories__list">
              {directory.numbers.map((number) => (
                <li class="directories__item">
                  <a href={number.href} class="directories__link">
                    {number.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .directories {
    background: var(--color-bg);
    padding-block: var(--space-section);
  }

  .directories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .directories__column {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }

  /* Fixed title band so every column starts lists at the same Y position */
  .directories__title-wrap {
    min-height: 2.75rem;
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 3px solid var(--color-accent);
    display: flex;
    align-items: flex-end;
  }

  .directories__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.2;
    margin: 0;
  }

  .directories__list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .directories__item {
    min-height: 1.75rem;
    display: flex;
    align-items: center;
  }

  .directories__link {
    display: block;
    width: 100%;
    font-size: var(--text-sm);
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    padding-block: 0.125rem;
    transition: color var(--transition-fast);
  }

  .directories__link:hover {
    color: var(--color-accent-dark);
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .directories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 3.5rem);
      row-gap: var(--space-2xl);
    }
  }

  @media (min-width: 1024px) {
    .directories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      row-gap: var(--space-3xl);
    }
  }
</style>
