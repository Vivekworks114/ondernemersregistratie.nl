---
import { mainNav } from '../data/navigation';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function normalizePath(href: string) {
  return href.replace(/\/$/, '') || '/';
}

function isActive(href: string) {
  const normalized = normalizePath(href);
  if (currentPath === normalized) return true;
  if (normalized === '/blog' && (currentPath === '/updates' || currentPath.startsWith('/updates/'))) {
    return true;
  }
  return false;
}

function isItemActive(item: (typeof mainNav)[number]) {
  if (isActive(item.href)) return true;
  return item.children?.some((child) => isActive(child.href)) ?? false;
}
---

<div class="navigation">

<nav class="nav" aria-label="Hoofdnavigatie">
  <ul class="nav__list">
    {
      mainNav.map((item) => (
        <li
          class:list={[
            'nav__item',
            item.children && 'nav__item--dropdown',
            isItemActive(item) && 'nav__item--active',
          ]}
        >
          {
            item.children ? (
              <>
                <button
                  type="button"
                  class="nav__trigger"
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-dropdown-trigger
                >
                  <span>{item.label}</span>
                  <svg class="nav__chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div class="nav__dropdown" data-dropdown-panel>
                  <div class="nav__dropdown-inner">
                    <p class="nav__dropdown-label">Populaire nummers</p>
                    <ul class="nav__dropdown-grid">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class:list={['nav__dropdown-link', isActive(child.href) && 'nav__dropdown-link--active']}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a href={item.href} class="nav__dropdown-all">
                      Alle telefoonnummers bekijken →
                    </a>
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class:list={['nav__link', isActive(item.href) && 'nav__link--active']}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            )
          }
        </li>
      ))
    }
  </ul>
</nav>

<button
  type="button"
  class="nav-toggle"
  aria-label="Menu openen"
  aria-expanded="false"
  aria-controls="mobile-nav"
  id="nav-toggle"
>
  <span class="nav-toggle__bar"></span>
  <span class="nav-toggle__bar"></span>
  <span class="nav-toggle__bar"></span>
</button>

<div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>

<aside class="mobile-nav" id="mobile-nav" aria-hidden="true" aria-label="Mobiel menu">
  <ul class="mobile-nav__list">
    {
      mainNav.map((item) => (
        <li class:list={['mobile-nav__item', item.children && 'mobile-nav__item--has-sub']}>
          {
            item.children ? (
              <>
                <button
                  type="button"
                  class="mobile-nav__trigger"
                  aria-expanded="false"
                  data-mobile-sub-trigger
                >
                  <span>{item.label}</span>
                  <svg class="mobile-nav__chevron" width="14" height="14" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul class="mobile-nav__sublist" data-mobile-sub-panel hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class="mobile-nav__sublink">
                        {child.label}
                      </a>
                    </li>
                  ))}
                  <li class="mobile-nav__sublist-all">
                    <a href={item.href} class="mobile-nav__sublink mobile-nav__sublink--all">
                      Alle telefoonnummers →
                    </a>
                  </li>
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                class:list={['mobile-nav__link', isActive(item.href) && 'mobile-nav__link--active']}
              >
                {item.label}
              </a>
            )
          }
        </li>
      ))
    }
    <li class="mobile-nav__item mobile-nav__item--cta">
      <a href="/contact/" class="btn btn--accent mobile-nav__cta">Adverteren?</a>
    </li>
  </ul>
</aside>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const backdrop = document.getElementById('mobile-nav-backdrop');

  function setMobileOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    mobileNav?.setAttribute('aria-hidden', String(!open));
    backdrop?.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('nav-open', open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setMobileOpen(open);
  });

  backdrop?.addEventListener('click', () => setMobileOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMobileOpen(false);
  });

  document.querySelectorAll('[data-mobile-sub-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      const panel = trigger.nextElementSibling as HTMLElement | null;
      trigger.setAttribute('aria-expanded', String(!expanded));
      trigger.parentElement?.classList.toggle('mobile-nav__item--open', !expanded);
      if (panel) panel.hidden = expanded;
    });
  });

  document.querySelectorAll('[data-dropdown-trigger]').forEach((trigger) => {
    const item = trigger.closest('.nav__item--dropdown') as HTMLElement | null;
    if (!item) return;

    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    function openDropdown() {
      clearTimeout(closeTimer);
      document.querySelectorAll('.nav__item--dropdown').forEach((el) => {
        if (el !== item) el.classList.remove('nav__item--open');
      });
      document.querySelectorAll('[data-dropdown-trigger]').forEach((el) => {
        if (el !== trigger) el.setAttribute('aria-expanded', 'false');
      });
      item.classList.add('nav__item--open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown(delay = 180) {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        item.classList.remove('nav__item--open');
        trigger.setAttribute('aria-expanded', 'false');
      }, delay);
    }

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (item.classList.contains('nav__item--open')) {
        closeDropdown(0);
      } else {
        openDropdown();
      }
    });

    item.addEventListener('mouseenter', openDropdown);
    item.addEventListener('mouseleave', () => closeDropdown());
    item.addEventListener('focusin', openDropdown);
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget as Node | null)) {
        closeDropdown(120);
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('.nav__item--dropdown')) return;
    document.querySelectorAll('.nav__item--dropdown').forEach((el) => el.classList.remove('nav__item--open'));
    document.querySelectorAll('[data-dropdown-trigger]').forEach((el) => el.setAttribute('aria-expanded', 'false'));
  });
</script>

<style>
  .navigation {
    display: contents;
  }

  @media (min-width: 1024px) {
    .navigation {
      display: block;
      justify-self: center;
    }
  }

  .nav {
    display: none;
    justify-self: center;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .nav__link,
  .nav__trigger {
    font-family: var(--font-nav);
    font-size: var(--text-sm);
    font-weight: 500;
    padding-block: 0.625rem;
    position: relative;
    color: var(--color-text);
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .nav__link::after,
  .nav__trigger::after {
    content: '';
    position: absolute;
    bottom: 0.25rem;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition-base);
  }

  .nav__link:hover::after,
  .nav__link--active::after,
  .nav__item--active .nav__trigger::after,
  .nav__trigger:hover::after,
  .nav__item--open .nav__trigger::after {
    width: 100%;
  }

  .nav__link:hover,
  .nav__link--active,
  .nav__trigger:hover,
  .nav__item--active .nav__trigger {
    opacity: 1;
  }

  .nav__chevron {
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  .nav__item--open .nav__chevron {
    transform: rotate(180deg);
  }

  .nav__item--dropdown {
    position: relative;
  }

  /* Invisible bridge so cursor can reach submenu without it closing */
  .nav__item--dropdown::after {
    content: '';
    position: absolute;
    left: -0.5rem;
    right: -0.5rem;
    top: 100%;
    height: 0.875rem;
    display: none;
  }

  .nav__item--dropdown:hover::after,
  .nav__item--dropdown:focus-within::after,
  .nav__item--open::after {
    display: block;
  }

  .nav__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 22rem;
    padding-top: 0.625rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      visibility 0.15s ease;
    z-index: 300;
  }

  .nav__item--dropdown:hover .nav__dropdown,
  .nav__item--dropdown:focus-within .nav__dropdown,
  .nav__item--open .nav__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav__dropdown-inner {
    background: var(--color-primary);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    padding: var(--space-md);
  }

  .nav__dropdown-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.55;
    margin-bottom: var(--space-sm);
    padding-inline: var(--space-xs);
  }

  .nav__dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    margin-bottom: var(--space-sm);
  }

  .nav__dropdown-link {
    display: block;
    padding: 0.5625rem 0.75rem;
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast), color var(--transition-fast);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .nav__dropdown-link:hover,
  .nav__dropdown-link--active {
    background: rgba(116, 255, 128, 0.18);
    opacity: 1;
    color: var(--color-text);
  }

  .nav__dropdown-link--active {
    font-weight: 600;
  }

  .nav__dropdown-all {
    display: block;
    padding: 0.625rem;
    font-size: var(--text-sm);
    font-weight: 600;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    margin-top: var(--space-xs);
    color: var(--color-accent-dark);
  }

  .nav__dropdown-all:hover {
    opacity: 1;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-toggle:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .nav-toggle__bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform var(--transition-base), opacity var(--transition-base);
  }

  :global(body.nav-open) .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  :global(body.nav-open) .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  :global(body.nav-open) .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-nav-backdrop {
    position: fixed;
    inset: 0;
    top: var(--header-height);
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-base),
      visibility var(--transition-base);
    z-index: 150;
  }

  :global(body.nav-open) .mobile-nav-backdrop {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    top: var(--header-height);
    width: min(22rem, 100%);
    margin-left: auto;
    background: var(--color-primary);
    padding: var(--space-lg) var(--container-padding);
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    z-index: 160;
    overflow-y: auto;
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.12);
  }

  :global(body.nav-open) .mobile-nav {
    transform: translateX(0);
  }

  .mobile-nav__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav__link,
  .mobile-nav__trigger {
    font-family: var(--font-nav);
    font-size: var(--text-lg);
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    text-align: left;
    color: var(--color-text);
    cursor: pointer;
  }

  .mobile-nav__link--active {
    color: var(--color-accent-dark);
  }

  .mobile-nav__chevron {
    transition: transform var(--transition-base);
    flex-shrink: 0;
  }

  .mobile-nav__item--open .mobile-nav__chevron {
    transform: rotate(180deg);
  }

  .mobile-nav__sublist {
    padding: 0 0 var(--space-sm) var(--space-md);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .mobile-nav__sublink {
    display: block;
    padding: 0.5rem 0;
    font-size: var(--text-sm);
    opacity: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .mobile-nav__sublink:hover {
    opacity: 1;
    color: var(--color-accent-dark);
  }

  .mobile-nav__sublink--all {
    font-weight: 600;
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px dashed rgba(0, 0, 0, 0.1);
    opacity: 1;
    color: var(--color-accent-dark);
  }

  .mobile-nav__item--cta {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .mobile-nav__cta {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .nav {
      display: block;
    }

    .nav-toggle,
    .mobile-nav,
    .mobile-nav-backdrop {
      display: none;
    }
  }
</style>
