---
import BlogCard from './BlogCard.astro';
import { getCollection } from 'astro:content';
import { resolveCardImageOrPlaceholder } from '../lib/blogImages';
import { formatBlogDate, postSlug, sortBlogPosts } from '../lib/blogPosts';

interface Props {
  limit?: number;
  showHeader?: boolean;
}

const { limit = 6, showHeader = true } = Astro.props;

const posts = sortBlogPosts(await getCollection('blog'));
const displayPosts = posts.slice(0, limit);
---

<section class="updates section">
  <div class="container">
    {
      showHeader && (
        <div class="section__header">
          <h2 class="section__title">Blog</h2>
          <p class="section__subtitle">
            Praktische tips, trends en advies voor ondernemers in Nederland.
          </p>
        </div>
      )
    }

    <div class="updates__grid">
      {
        displayPosts.map((post) => {
          const slug = postSlug(post);
          return (
            <BlogCard
              title={post.data.title}
              excerpt={post.data.description}
              date={formatBlogDate(post.data.pubDate)}
              dateISO={post.data.pubDate.toISOString()}
              slug={slug}
              featuredImage={resolveCardImageOrPlaceholder(
                post.data,
                post.body,
                slug,
                post.data.title,
              )}
              variant="compact"
            />
          );
        })
      }
    </div>

    {
      showHeader && (
        <div class="updates__footer">
          <a href="/blog/" class="btn btn--accent">
            Bekijk de blog
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .updates {
    background: var(--color-primary);
  }

  .updates__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    align-items: start;
  }

  .updates__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .updates__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: clamp(1.5rem, 3vw, 2.5rem);
    }
  }

  @media (min-width: 1024px) {
    .updates__grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: clamp(2rem, 3vw, 3.5rem);
    }
  }
</style>
