---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  dateISO: string;
  slug: string;
  featuredImage?: string;
  variant?: 'compact' | 'full';
}

const {
  title,
  excerpt,
  date,
  dateISO,
  slug,
  featuredImage = '/images/blog/featured-1.png',
  variant = 'full',
} = Astro.props;
const postUrl = `/${slug}/`;
const isCompact = variant === 'compact';
---

<article class:list={['blog-card', isCompact && 'blog-card--compact']}>
  <a href={postUrl} class="blog-card__image-link" tabindex="-1" aria-hidden="true">
    <div class="blog-card__image">
      <img
        src={featuredImage}
        alt=""
        width="1024"
        height="576"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>
  <div class="blog-card__body">
    <h3 class="blog-card__title">
      <a href={postUrl}>{title}</a>
    </h3>
    <time class="blog-card__date" datetime={dateISO}>{date}</time>
    <p class="blog-card__excerpt">{excerpt}</p>
    <a href={postUrl} class="blog-card__read-more" aria-label={`Lees meer over ${title}`}>
      Helemaal lezen »
    </a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-primary);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .blog-card__image-link {
    display: block;
    opacity: 1;
  }

  .blog-card__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }

  .blog-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform var(--transition-slow);
  }

  .blog-card:hover .blog-card__image img {
    transform: scale(1.03);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-lg);
    gap: var(--space-sm);
  }

  .blog-card__title {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
  }

  .blog-card__title a:hover {
    color: var(--color-accent-dark);
    opacity: 1;
  }

  .blog-card__date {
    font-size: var(--text-sm);
    opacity: 0.7;
  }

  .blog-card__excerpt {
    flex: 1;
    font-size: var(--text-sm);
    line-height: 1.6;
    opacity: 0.9;
  }

  .blog-card__read-more {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-top: auto;
    padding-top: var(--space-sm);
  }

  .blog-card__read-more:hover {
    color: var(--color-accent-dark);
    opacity: 1;
  }

  .blog-card--compact {
    border: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0;
    background: transparent;
    height: auto;
  }

  .blog-card--compact:hover {
    transform: none;
    box-shadow: none;
  }

  .blog-card--compact .blog-card__image {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .blog-card--compact .blog-card__body {
    padding: var(--space-md) 0 var(--space-lg);
    gap: 0.625rem;
  }

  .blog-card--compact .blog-card__title {
    font-size: var(--text-base);
    line-height: 1.4;
  }

  .blog-card--compact .blog-card__date {
    order: -1;
    font-size: var(--text-xs);
    text-transform: capitalize;
  }

  .blog-card--compact .blog-card__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card--compact .blog-card__read-more {
    padding-top: var(--space-xs);
    font-weight: 700;
  }

  .blog-card--compact:hover .blog-card__image img {
    transform: none;
  }
</style>
