---
interface Props {
  label: string;
  slug: string;
}

const { label, slug } = Astro.props;
const searchId = `phone-search-${slug}`;

const areaCodes = [
  { code: '020', city: 'Amsterdam' },
  { code: '010', city: 'Rotterdam' },
  { code: '070', city: 'Den Haag' },
  { code: '071', city: 'Leiden' },
  { code: '030', city: 'Utrecht' },
  { code: '043', city: 'Maastricht' },
  { code: '013', city: 'Tilburg' },
];

const blockSteps = [
  `Blokkeer ${label} via de instellingen van je telefoon. Op een iPhone ga je naar ‘Recent’, klik je op het ‘i’-icoon naast het nummer en selecteer je ‘Blokkeer deze beller’. Op een Android-toestel open je de Telefoon-app, ga je naar ‘Recent’, klik je op het nummer en kies je voor ‘Blokkeren’.`,
  'Geef het nummer door aan je provider.',
  'Installeer een app zoals Truecaller om spamoproepen te filteren.',
  `Meld ${label} op een waarschuwingssite.`,
  'Dien een officiële klacht in bij de ACM.',
  'Controleer of je onterecht marketingtelefoontjes krijgt en trek je toestemming in.',
];

const promoLinks = [
  {
    href: '/category/',
    label: 'Zoek telefoonnummers',
    icon: '/images/phone/pixelarticons_search.png',
  },
  {
    href: '/telefoonnummers/',
    label: 'Lijst met NL nummers',
    icon: '/images/phone/pixelarticons_list-box.png',
  },
  {
    href: '/',
    label: 'Wie zit er achter het nummer?',
    sub: 'Ontdek het eenvoudig op Ondernemersregistratie.nl',
    icon: '/images/phone/pixelarticons_chat.png',
    accent: true,
  },
];
---

<article class="phone-page">
  <div class="phone-page__container container">
    <header class="phone-page__hero">
      <div class="phone-page__hero-content">
        <nav class="phone-page__breadcrumb" aria-label="Breadcrumb">
          <ol itemscope itemtype="https://schema.org/BreadcrumbList">
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/" class="phone-page__breadcrumb-home" itemprop="item" aria-label="Home">
                <img src="/images/phone/lucide_home4.png" alt="" width="18" height="18" />
                <meta itemprop="name" content="Home" />
              </a>
              <meta itemprop="position" content="1" />
            </li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <a href="/telefoonnummers/" itemprop="item">
                <span itemprop="name">nummer</span>
              </a>
              <meta itemprop="position" content="2" />
            </li>
            <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
              <span itemprop="name" aria-current="page">{label}</span>
              <meta itemprop="position" content="3" />
            </li>
          </ol>
        </nav>

        <h1 class="phone-page__title">{label}</h1>
        <p class="phone-page__lead">
          Omgekeerd zoeken op voor telefoonnummer {label} kan op ondernemersregistratie.nl.
        </p>

        <form class="phone-page__search" action="/telefoonnummers/" method="get" role="search">
          <label for={searchId} class="sr-only">Zoek telefoonnummer</label>
          <div class="phone-page__search-row">
            <input
              type="search"
              id={searchId}
              name="s"
              class="phone-page__search-input"
              placeholder="Search"
              autocomplete="off"
            />
            <button type="submit" class="phone-page__search-btn btn btn--accent">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M8.75008 15.8333C12.6622 15.8333 15.8334 12.6621 15.8334 8.74999C15.8334 4.83791 12.6622 1.66666 8.75008 1.66666C4.838 1.66666 1.66675 4.83791 1.66675 8.74999C1.66675 12.6621 4.838 15.8333 8.75008 15.8333Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
                <path d="M11.1072 5.97625C10.798 5.66627 10.4306 5.42044 10.0261 5.2529C9.62161 5.08536 9.18798 4.99942 8.75015 5C8.31232 4.99942 7.87869 5.08536 7.47418 5.2529C7.06968 5.42044 6.70226 5.66627 6.39307 5.97625M13.8426 13.8425L17.3781 17.3779" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              Search
            </button>
          </div>
        </form>
      </div>

      <figure class="phone-page__hero-media">
        <img
          src="/images/phone/image36.png"
          alt="Persoon die een telefoonnummer opzoekt"
          width="570"
          height="380"
          loading="eager"
        />
      </figure>
    </header>

    <section class="phone-page__split">
      <div class="phone-page__split-content">
        <h2 class="phone-page__h2">Gemiste oproep van {label}</h2>
        <p>
          Zie jij een gemiste oproep van Unknown? Hier kun je omgekeerd zoeken op telefoonnummer {label} om
          te zien wie er achter zit.
        </p>
        <p>
          Is het een verkoper of is het een scam? Belangrijk is dat je weet wie er achter {label} zit zodat
          je weet of je veilig kunt terugbellen of kunt opnemen de volgende keer!
        </p>
      </div>
      <figure class="phone-page__split-media">
        <img
          src="/images/phone/unsplash_eZFPIyjJQxM5.png"
          alt=""
          width="472"
          height="218"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="phone-page__split phone-page__split--reverse">
      <figure class="phone-page__split-media">
        <img
          src="/images/phone/unsplash_eZFPIyjJQxM6.png"
          alt=""
          width="472"
          height="263"
          loading="lazy"
        />
      </figure>
      <div class="phone-page__split-content">
        <h3 class="phone-page__h3">Gebeld door {label} | Wie zit er achter?</h3>
        <p>
          Ben jij gebeld door {label} en weet je niet wie het is? Zou je graag eerst weten wie er achter dit
          nummer zit voordat je terugbelt? Groot gelijk heb je!
        </p>
        <p>
          Aan het netnummer kun je zien uit welke regio de gemiste oproep van {label} komt. Kijk dus naar de
          eerste 3 cijfers van de gemiste oproep. Hieronder bekijk je de netnummers van enkele grote steden
          in Nederland.
        </p>
        <ul class="phone-page__area-codes">
          {
            areaCodes.map(({ code, city }) => (
              <li>
                <strong>{code}</strong> — {city}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="phone-page__split">
      <div class="phone-page__split-content">
        <h3 class="phone-page__h3">Voorkom ongewenste belletjes van {label}</h3>
        <p>
          Je wordt gebeld door een {label}. Je hebt niet opgenomen en hebt dus geen idee wie er achter dit
          nummer zit.
        </p>
        <p>
          Word je telkens lastiggevallen door {label}? Dan kun je daar gelukkig iets aan doen. Blokkeer het
          nummer eenvoudig via de instellingen van je telefoon of installeer een app die ongewenste oproepen
          herkent en automatisch blokkeert.
        </p>
        <p>
          Daarnaast kun je het nummer melden bij je telecomprovider, een waarschuwingssite of bij de
          Autoriteit Consument &amp; Markt (ACM). Zo help je niet alleen jezelf, maar ook anderen om
          beschermd te blijven tegen storende telefoontjes van {label}.
        </p>
      </div>
      <figure class="phone-page__split-media">
        <img
          src="/images/phone/unsplash_eZFPIyjJQxM7.png"
          alt=""
          width="472"
          height="263"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="phone-page__split phone-page__split--reverse">
      <figure class="phone-page__split-media">
        <img
          src="/images/phone/unsplash_eZFPIyjJQxM8.png"
          alt=""
          width="472"
          height="255"
          loading="lazy"
        />
      </figure>
      <div class="phone-page__split-content">
        <h2 class="phone-page__h2">Blokkeer {label} en wordt niet meer gebeld</h2>
        <p>Hieronder vind je een handige checklist:</p>
        <ul class="phone-page__checklist">
          {blockSteps.map((step) => <li>{step}</li>)}
        </ul>
      </div>
    </section>

    <aside class="phone-page__promo" aria-label="Gerelateerde pagina's">
      {
        promoLinks.map((item) => (
          <a
            href={item.href}
            class:list={['phone-page__promo-card', item.accent && 'phone-page__promo-card--accent']}
          >
            <img src={item.icon} alt="" width="32" height="32" class="phone-page__promo-icon" loading="lazy" />
            <span class="phone-page__promo-label">{item.label}</span>
            {item.sub && <span class="phone-page__promo-sub">{item.sub}</span>}
          </a>
        ))
      }
    </aside>
  </div>
</article>

<style>
  .phone-page {
    padding-block: clamp(2rem, 4vw, 3rem) var(--space-section);
    background: var(--color-bg);
  }

  .phone-page__container {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 7vw, 5.5rem);
    max-width: var(--container-narrow);
  }

  /* ── Shared row layout (matches live Elementor 50/50 rows) ── */
  .phone-page__hero,
  .phone-page__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--layout-split-gap);
    align-items: center;
  }

  .phone-page__hero-content,
  .phone-page__split-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .phone-page__split-content p,
  .phone-page__lead {
    margin: 0;
    line-height: 1.7;
    font-size: var(--text-base);
    color: rgba(0, 0, 0, 0.82);
  }

  .phone-page__hero-media,
  .phone-page__split-media {
    margin: 0;
    min-width: 0;
    width: 100%;
    max-width: var(--layout-media-max);
    justify-self: center;
  }

  .phone-page__hero-media img,
  .phone-page__split-media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    object-fit: cover;
    display: block;
    aspect-ratio: 4 / 3;
  }

  /* ── Breadcrumb ── */
  .phone-page__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: var(--space-sm);
    font-size: var(--text-sm);
    text-transform: lowercase;
    color: rgba(0, 0, 0, 0.7);
  }

  .phone-page__breadcrumb li {
    display: inline-flex;
    align-items: center;
  }

  .phone-page__breadcrumb li:not(:last-child)::after {
    content: '>';
    margin-inline: 0.5rem;
    opacity: 0.45;
  }

  .phone-page__breadcrumb-home {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .phone-page__breadcrumb-home img {
    width: 1.125rem;
    height: 1.125rem;
  }

  .phone-page__breadcrumb a:hover {
    color: var(--color-accent-dark);
    opacity: 1;
  }

  .phone-page__breadcrumb span[itemprop='name'][aria-current='page'] {
    opacity: 0.65;
  }

  /* ── Typography ── */
  .phone-page__title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    word-break: break-word;
  }

  .phone-page__h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.15;
    margin: 0;
    color: var(--color-text);
  }

  .phone-page__h3 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 1.875rem);
    line-height: 1.2;
    margin: 0;
    color: var(--color-text);
  }

  /* ── Search ── */
  .phone-page__search {
    margin-top: var(--space-sm);
  }

  .phone-page__search-row {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 100%;
  }

  .phone-page__search-input {
    width: 100%;
    padding: 1rem 1.375rem;
    border: 1px solid var(--color-text);
    border-radius: var(--radius-pill) var(--radius-pill) 0 0;
    background: var(--color-primary);
    font-size: var(--text-base);
  }

  .phone-page__search-input:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(116, 255, 128, 0.35);
  }

  .phone-page__search-btn {
    width: 100%;
    border-radius: 0 0 var(--radius-pill) var(--radius-pill);
    border: 1px solid var(--color-text);
    border-top: none;
    padding: 1rem 1.75rem;
    gap: 0.5rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (min-width: 540px) {
    .phone-page__search-row {
      flex-direction: row;
      align-items: stretch;
    }

    .phone-page__search-input {
      flex: 1;
      min-width: 0;
      border-radius: var(--radius-pill) 0 0 var(--radius-pill);
      border-right: none;
    }

    .phone-page__search-btn {
      width: auto;
      flex-shrink: 0;
      border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
      border: 1px solid var(--color-text);
      border-left: none;
      padding-inline: 2rem;
    }
  }

  /* ── Area codes (plain list like live site) ── */
  .phone-page__area-codes {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: var(--space-lg) 0 0;
    padding: var(--space-lg) 0 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    list-style: none;
  }

  .phone-page__area-codes li {
    font-size: var(--text-base);
    line-height: 1.65;
    color: rgba(0, 0, 0, 0.82);
  }

  .phone-page__area-codes strong {
    font-weight: 700;
    min-width: 2.5rem;
    display: inline-block;
  }

  /* ── Checklist ── */
  .phone-page__checklist {
    margin: 0;
    padding-left: 1.375rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    list-style: disc;
  }

  .phone-page__checklist li {
    line-height: 1.7;
    font-size: var(--text-sm);
  }

  /* ── Desktop: every row uses identical 50/50 columns, vertically centered ── */
  @media (min-width: 1024px) {
    .phone-page__hero,
    .phone-page__split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 5rem);
      row-gap: 0;
      align-items: center;
    }

    .phone-page__hero-content,
    .phone-page__split-content {
      max-width: var(--layout-content-max);
    }

    .phone-page__hero-media,
    .phone-page__split-media {
      justify-self: stretch;
    }
  }

  /* ── Promo cards ── */
  .phone-page__promo {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .phone-page__promo-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    min-height: 7rem;
    padding: var(--space-lg) var(--space-xl);
    background: var(--color-primary);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: var(--radius-md);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .phone-page__promo-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
    opacity: 1;
  }

  .phone-page__promo-card--accent {
    background: var(--color-card-dark);
    border-color: var(--color-card-dark);
  }

  .phone-page__promo-icon {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .phone-page__promo-card--accent .phone-page__promo-icon {
    filter: brightness(0) saturate(100%) invert(84%) sepia(52%) saturate(638%) hue-rotate(65deg) brightness(103%) contrast(101%);
  }

  .phone-page__promo-label {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.35;
  }

  .phone-page__promo-card--accent .phone-page__promo-label {
    color: var(--color-card-text);
  }

  .phone-page__promo-sub {
    font-size: var(--text-sm);
    line-height: 1.5;
    opacity: 0.85;
  }

  .phone-page__promo-card--accent .phone-page__promo-sub {
    color: rgba(255, 255, 255, 0.78);
  }

  @media (min-width: 768px) {
    .phone-page__promo {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }
</style>
