---
import type { CollectionEntry } from 'astro:content';
import PageLayout from './PageLayout.astro';
import { resolveHeroImageOrStock } from '../lib/blogImages';
import { formatBlogDate, postSlug, postUrl } from '../lib/blogPosts';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const pubDate = formatBlogDate(entry.data.pubDate);
const slug = postSlug(entry);
const heroSrc = resolveHeroImageOrStock(entry.data, entry.body, slug, entry.data.title);
const canonical = `https://ondernemersregistratie.nl${postUrl(entry)}`;
---

<PageLayout
  title={`${entry.data.title} - Ondernemersregistratie.nl`}
  description={entry.data.description}
  canonical={canonical}
>
  <article class="blog-post section">
    <div class="container container--narrow">
      <div class="blog-post__layout">
        <header class="blog-post__header">
          <a href="/updates/" class="blog-post__back">← Terug naar updates</a>
          <time class="blog-post__date" datetime={entry.data.pubDate.toISOString()}>
            {pubDate}
          </time>
          <h1 class="blog-post__title">{entry.data.title}</h1>
          {entry.data.author && <p class="blog-post__author">Door {entry.data.author}</p>}
        </header>

        {
          heroSrc && (
            <div class="blog-post-hero">
              <img
                src={heroSrc}
                alt={entry.data.title}
                width="1080"
                height="420"
                loading="eager"
                decoding="async"
              />
            </div>
          )
        }

        <div class="blog-post__content prose">
          <slot />
        </div>
      </div>
    </div>
  </article>
</PageLayout>

<style>
  .blog-post {
    padding-block: var(--space-2xl) var(--space-section);
  }

  .blog-post__layout {
    max-width: 48rem;
    margin-inline: auto;
  }

  .blog-post__header {
    margin-bottom: var(--space-xl);
  }

  .blog-post__back {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-lg);
    transition: color var(--transition-fast);
  }

  .blog-post__back:hover {
    color: var(--color-accent-dark);
    opacity: 1;
  }

  .blog-post__date {
    display: block;
    font-size: var(--text-sm);
    opacity: 0.7;
    margin-bottom: var(--space-sm);
  }

  .blog-post__author {
    font-size: var(--text-sm);
    opacity: 0.8;
    margin-top: var(--space-sm);
  }

  .blog-post__title {
    max-width: none;
  }

  .blog-post-hero {
    margin: 0 0 1.5rem;
  }

  .blog-post-hero img {
    width: 100%;
    max-height: 420px;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
    background: rgba(0, 0, 0, 0.04);
  }

  .blog-post__content {
    max-width: none;
    text-align: left;
  }

  .blog-post__content :global(h2) {
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }

  .blog-post__content :global(p) {
    margin-bottom: var(--space-lg);
  }

  .blog-post__content :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-lg);
    max-width: 100%;
    height: auto;
  }
</style>
